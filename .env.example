APP_NAME="Joao Domingues Imobiliario"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Lisbon

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

# Site público. Entra no e-mail dos leads e no link de redefinição de senha.
FRONTEND_URL=https://joaodomingues.vercel.app

# Origens autorizadas a chamar a API a partir do browser. Sem barra no fim.
CORS_ALLOWED_ORIGINS=https://joaodomingues.vercel.app,http://localhost:5510,http://127.0.0.1:5510,http://localhost:5500,http://127.0.0.1:5500

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joao_domingues
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# sync envia o e-mail no próprio pedido. Em produção use database e corra o worker.
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em local pode ficar "log" para escrever o e-mail em storage/logs em vez de enviar.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Destinatário dos formulários do site. O visitante vai em Reply-To, nunca em From.
LEADS_NOTIFICATION_EMAIL=jmdomingues@remax.pt

VITE_APP_NAME="${APP_NAME}"
